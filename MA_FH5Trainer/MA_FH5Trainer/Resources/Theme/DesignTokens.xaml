<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <!-- ==================== Design Tokens: Typography ==================== -->

    <!-- Font Families -->
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="HeaderFontFamily">Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes -->
    <system:Double x:Key="FontSizeExtraSmall">10</system:Double>
    <system:Double x:Key="FontSizeSmall">12</system:Double>
    <system:Double x:Key="FontSizeNormal">14</system:Double>
    <system:Double x:Key="FontSizeMedium">16</system:Double>
    <system:Double x:Key="FontSizeLarge">18</system:Double>
    <system:Double x:Key="FontSizeExtraLarge">20</system:Double>
    <system:Double x:Key="FontSizeXLarge">22</system:Double>
    <system:Double x:Key="FontSizeXXLarge">24</system:Double>
    <system:Double x:Key="FontSizeXXXLarge">32</system:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- Line Heights -->
    <system:Double x:Key="LineHeightTight">1.2</system:Double>
    <system:Double x:Key="LineHeightNormal">1.5</system:Double>
    <system:Double x:Key="LineHeightRelaxed">1.75</system:Double>

    <!-- Letter Spacing -->
    <system:Double x:Key="LetterSpacingTight">-0.5</system:Double>
    <system:Double x:Key="LetterSpacingNormal">0</system:Double>
    <system:Double x:Key="LetterSpacingWide">0.5</system:Double>

    <!-- ==================== Design Tokens: Spacing ==================== -->

    <!-- Base Spacing Unit -->
    <system:Double x:Key="SpacingUnit">4</system:Double>

    <!-- Padding -->
    <Thickness x:Key="PaddingNone">0</Thickness>
    <Thickness x:Key="PaddingXS">4</Thickness>
    <Thickness x:Key="PaddingS">8</Thickness>
    <Thickness x:Key="PaddingM">12</Thickness>
    <Thickness x:Key="PaddingL">16</Thickness>
    <Thickness x:Key="PaddingXL">20</Thickness>
    <Thickness x:Key="PaddingXXL">24</Thickness>

    <!-- Margin -->
    <Thickness x:Key="MarginNone">0</Thickness>
    <Thickness x:Key="MarginXS">4</Thickness>
    <Thickness x:Key="MarginS">8</Thickness>
    <Thickness x:Key="MarginM">12</Thickness>
    <Thickness x:Key="MarginL">16</Thickness>
    <Thickness x:Key="MarginXL">20</Thickness>
    <Thickness x:Key="MarginXXL">24</Thickness>

    <!-- ==================== Design Tokens: Layout & Shapes ==================== -->

    <!-- Corner Radius -->
    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusS">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusM">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusL">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXL">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusXXL">16</CornerRadius>

    <!-- Component Corner Radius -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">16</CornerRadius>

    <!-- Border Thickness -->
    <Thickness x:Key="BorderThicknessNone">0</Thickness>
    <Thickness x:Key="BorderThicknessThin">1</Thickness>
    <Thickness x:Key="BorderThicknessNormal">2</Thickness>
    <Thickness x:Key="BorderThicknessThick">3</Thickness>

    <!-- Alias for ControlBorderThickness (was in ThemeConstants) -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness>

    <!-- ==================== Design Tokens: Effects & Animation ==================== -->

    <!-- Shadow Depths -->
    <system:Double x:Key="ShadowDepthXS">0</system:Double>
    <system:Double x:Key="ShadowDepthS">2</system:Double>
    <system:Double x:Key="ShadowDepthM">4</system:Double>
    <system:Double x:Key="ShadowDepthL">8</system:Double>
    <system:Double x:Key="ShadowDepthXL">16</system:Double>

    <!-- Animation Durations -->
    <Duration x:Key="AnimationDurationFast">0:0:0.1</Duration>
    <Duration x:Key="AnimationDurationNormal">0:0:0.2</Duration>
    <Duration x:Key="AnimationDurationSlow">0:0:0.3</Duration>

    <!-- ==================== Design Tokens: Constants ==================== -->

    <system:Double x:Key="MinTouchTargetSize">40</system:Double>
    <system:Double x:Key="IconSizeSmall">16</system:Double>
    <system:Double x:Key="IconSizeNormal">20</system:Double>
    <system:Double x:Key="IconSizeLarge">24</system:Double>
    <system:Double x:Key="IconSizeXLarge">32</system:Double>

    <!-- Legacy Constants from ThemeConstants.xaml -->
    <system:Int32 x:Key="SliderTooltipPrecision">2</system:Int32>
    <AutoToolTipPlacement x:Key="SliderAutoToolTipPlacement">BottomRight</AutoToolTipPlacement>

    <!-- ==================== Common Styles ==================== -->

    <Style x:Key="TextStyle.Heading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource HeaderFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXLarge}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource MarginS}"/>
    </Style>

    <Style x:Key="TextStyle.Subheading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource HeaderFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource MarginXS}"/>
    </Style>

    <Style x:Key="TextStyle.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightNormal}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource MarginXS}"/>
    </Style>

    <Style x:Key="TextStyle.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="{DynamicResource MarginXS}"/>
    </Style>

    <Style x:Key="TextStyle.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightNormal}"/>
        <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightRelaxed}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource MarginXS}"/>
    </Style>

    <!-- Small Heading Style -->
    <Style x:Key="TextStyle.SmallHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource HeaderFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMedium}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{DynamicResource MarginXS}"/>
    </Style>

    <!-- Emphasis Text Style -->
    <Style x:Key="TextStyle.Emphasis" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Secondary Emphasis Style -->
    <Style x:Key="TextStyle.SecondaryEmphasis" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightSemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Text Gradient Style -->
    <Style x:Key="TextGradientStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TitleGradientBrush}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Title Text Style -->
    <Style x:Key="TitleTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextGradientStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXXLarge}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightBold}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightTight}"/>
        <Setter Property="Margin" Value="{DynamicResource MarginS}"/>
    </Style>

    <!-- Expander Title Style -->
    <Style x:Key="ExpanderTitleTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextGradientStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
    </Style>

    <!-- Common Border Style (Merged from CommonBorderStyle.xaml) -->
    <Style x:Key="CommonBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Margin" Value="{DynamicResource MarginS}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingM}"/>
        <Setter Property="Effect" Value="{DynamicResource CardGlowEffect}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                <Setter Property="Effect" Value="{DynamicResource CardGlowEffectHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Standard Input Control Style -->
    <Style x:Key="StandardInputStyle" TargetType="Control">
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource BorderFocusedBrush}"/>
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="{StaticResource BorderThicknessThin}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingM}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Form Validation Status Text Styles -->
    <Style x:Key="TextStyle.Success" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TextStyle.Warning" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TextStyle.Error" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="LineHeight" Value="{DynamicResource LineHeightNormal}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ==================== Easing Functions ==================== -->

    <!-- Basic Quadratic Easing -->
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="EaseIn" EasingMode="EaseIn"/>
    <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut"/>

    <!-- Cubic Easing for more dramatic effects -->
    <CubicEase x:Key="EaseOutCubic" EasingMode="EaseOut"/>
    <CubicEase x:Key="EaseInCubic" EasingMode="EaseIn"/>

    <!-- ==================== Interactive Styles ==================== -->

    <!-- Interactive Button Style with smooth transitions -->
    <Style x:Key="InteractiveButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Interactive Card Style with hover glow effect -->
    <Style x:Key="InteractiveCardStyle" TargetType="Border">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{DynamicResource CardGlowEffect}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource CardGlowEffectHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== Micro-Animation Storyboards ==================== -->

    <!-- Fade In Animation -->
    <Storyboard x:Key="FadeInAnimation">
        <DoubleAnimation From="0" To="1" Duration="{StaticResource AnimationDurationNormal}"
                       EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Fade Out Animation -->
    <Storyboard x:Key="FadeOutAnimation">
        <DoubleAnimation From="1" To="0" Duration="{StaticResource AnimationDurationNormal}"
                       EasingFunction="{StaticResource EaseIn}"/>
    </Storyboard>

    <!-- Scale Up Animation (use with RenderTransform) -->
    <Storyboard x:Key="ScaleUpAnimation">
        <DoubleAnimation To="1.02" Duration="{StaticResource AnimationDurationFast}"
                       EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Slide In Animation (use with TranslateTransform) -->
    <Storyboard x:Key="SlideInAnimation">
        <DoubleAnimation From="-20" To="0" Duration="{StaticResource AnimationDurationNormal}"
                       EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

</ResourceDictionary>
