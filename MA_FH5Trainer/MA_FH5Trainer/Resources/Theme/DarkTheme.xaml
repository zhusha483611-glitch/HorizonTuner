<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Dark Theme Colors ==================== -->

    <!-- Core Palette Colors (Semantic Color System) -->
    <Color x:Key="Color.Primary.600">#4CC2FF</Color>
    <Color x:Key="Color.Primary.700">#66D1FF</Color>
    <Color x:Key="Color.Primary.800">#33B3EE</Color>
    <Color x:Key="Color.Primary.200">#99E0FF</Color>
    <Color x:Key="Color.Primary.100">#CCF0FF</Color>

    <Color x:Key="Color.Neutral.0">#FFFFFF</Color>
    <Color x:Key="Color.Neutral.50">#F0F0F0</Color>
    <Color x:Key="Color.Neutral.100">#E0E0E0</Color>
    <Color x:Key="Color.Neutral.200">#C0C0C0</Color>
    <Color x:Key="Color.Neutral.300">#A0A0A0</Color>
    <Color x:Key="Color.Neutral.400">#808080</Color>
    <Color x:Key="Color.Neutral.600">#666666</Color>
    <Color x:Key="Color.Neutral.700">#4A4A4A</Color>
    <Color x:Key="Color.Neutral.900">#1A1A1A</Color>

    <Color x:Key="Color.Success.600">#6CCB6F</Color>
    <Color x:Key="Color.Warning.600">#FFAA40</Color>
    <Color x:Key="Color.Error.600">#FF6B6B</Color>
    <Color x:Key="Color.Info.600">#4CC2FF</Color>

    <!-- Core Palette Brushes (Back-compat keys) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Color.Primary.600}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.AccentBase" Color="{StaticResource Color.Primary.600}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{StaticResource Color.Primary.700}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Accent2" Color="{StaticResource Color.Primary.800}"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Highlight" Color="#2A5A75"/>
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Disabled" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource Color.Primary.700}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource Color.Primary.800}"/>
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#2A5A75"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="#5BA3D8"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#7BB8E8"/>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Color.Neutral.900}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource Color.Neutral.700}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D2D"/>

    <!-- Foregrounds -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource Color.Neutral.900}"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="{StaticResource Color.Primary.600}"/>

    <!-- Slider Track -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#555555"/>
    <SolidColorBrush x:Key="SliderThumbActiveBorderBrush" Color="{StaticResource Color.Neutral.0}"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Color.Success.600}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Color.Warning.600}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Color.Error.600}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Color.Info.600}"/>
    <SolidColorBrush x:Key="AttachedBrush" Color="{StaticResource Color.Success.600}"/>
    <SolidColorBrush x:Key="DetachedBrush" Color="{StaticResource Color.Error.600}"/>

    <!-- Auxiliary Theme Brushes -->
    <SolidColorBrush x:Key="HyperlinkBrush" Color="{StaticResource Color.Primary.600}"/>
    <SolidColorBrush x:Key="DonateButtonBrush" Color="{StaticResource Color.Warning.600}"/>
    <SolidColorBrush x:Key="AuxiliaryButtonBrush" Color="{StaticResource Color.Neutral.600}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource Color.Neutral.400}"/>
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="{StaticResource Color.Neutral.0}"/>

    <!-- ==================== Semantic UI Colors (Mapped from Theming.cs) ==================== -->
    
    <!-- Main Window Background (MainColour) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C1C"/>
    
    <!-- Title Bar Background (DarkColour) -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#0D0D0D"/>
    
    <!-- Side Bar Background (DarkishColour) -->
    <SolidColorBrush x:Key="SideBarBackgroundBrush" Color="#121212"/>
    
    <!-- Controls/Buttons Background (LightColour) -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#242424"/>
    
    <!-- Input/ComboBox Background (DarkerColour) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#080808"/>
    
    <!-- Secondary/Highlight Background (LighterColour) -->
    <SolidColorBrush x:Key="HighlightBackgroundBrush" Color="#2C2C2C"/>

    <SolidColorBrush x:Key="HandlingInputSurfaceBrush" Color="#252525"/>
    <SolidColorBrush x:Key="HandlingInputSurfaceHoverBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="HandlingInputSurfaceSelectedBrush" Color="#303030"/>

    <!-- ==================== Theme Specific Gradients & Effects ==================== -->

    <!-- Card Background Gradient -->
    <LinearGradientBrush x:Key="CardBackgroundGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1A1A" Offset="0"/>
        <GradientStop Color="#121212" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass Border Gradient -->
    <LinearGradientBrush x:Key="CardBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4CC2FF" Offset="0"/>
        <GradientStop Color="Transparent" Offset="0.5"/>
        <GradientStop Color="#4CC2FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shadow Colors -->
    <Color x:Key="ShadowColor">#30000000</Color>
    <Color x:Key="ShadowColorLight">#20000000</Color>
    <Color x:Key="ShadowColorDark">#50000000</Color>

    <!-- Text Gradient (Warm Colors: Red->Orange->Yellow) -->
    <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF6B6B" Offset="0"/>
        <GradientStop Color="#FF8E53" Offset="0.5"/>
        <GradientStop Color="#FFC75F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glow Effects (Blue Glow) -->
    <DropShadowEffect x:Key="CardGlowEffect"
                      Color="#4CC2FF"
                      BlurRadius="12"
                      ShadowDepth="3"
                      Direction="270"
                      Opacity="0.20"
                      RenderingBias="Quality"/>

    <DropShadowEffect x:Key="CardGlowEffectHover"
                      Color="#4CC2FF"
                      BlurRadius="16"
                      ShadowDepth="5"
                      Direction="270"
                      Opacity="0.30"
                      RenderingBias="Quality"/>

    <DropShadowEffect x:Key="CardGlowEffectActive"
                      Color="#4CC2FF"
                      BlurRadius="20"
                      ShadowDepth="7"
                      Direction="270"
                      Opacity="0.40"
                      RenderingBias="Quality"/>

    <!-- Highlight Glow Effect -->
    <DropShadowEffect x:Key="HighlightGlowEffect"
                      Color="{StaticResource Color.Primary.600}"
                      BlurRadius="16"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.30"
                      RenderingBias="Quality"/>

    <!-- Success Glow Effect -->
    <DropShadowEffect x:Key="SuccessGlowEffect"
                      Color="{StaticResource Color.Success.600}"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.25"
                      RenderingBias="Quality"/>

    <!-- Error Glow Effect -->
    <DropShadowEffect x:Key="ErrorGlowEffect"
                      Color="{StaticResource Color.Error.600}"
                      BlurRadius="12"
                      ShadowDepth="2"
                      Opacity="0.25"
                      RenderingBias="Quality"/>

</ResourceDictionary>
