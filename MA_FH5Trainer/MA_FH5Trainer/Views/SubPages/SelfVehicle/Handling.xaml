        <Border Style="{StaticResource CommonBorderStyle}">
            <Grid Margin="5 0">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <mah:NumericUpDown Grid.Column="0"
                                   VerticalAlignment="Center"
                                   x:Name="StopBox"
                                   Minimum="1"
                                   Margin="2 0 0 0"
                                   Maximum="5"
                                   Value="{Binding Value, ElementName=StopSlider}"
                                   Width="100"
                                   Style="{StaticResource HandlingCompactNumericUpDownStyle}">
                    <mah:NumericUpDown.IsEnabled>
                        <MultiBinding Converter="{StaticResource AndBooleanMultiConverter}">
                            <Binding Path="IsEnabled" ElementName="StopToggle"/>
                            <Binding Path="IsOn" ElementName="StopToggle"/>
                        </MultiBinding>
                    </mah:NumericUpDown.IsEnabled>
                </mah:NumericUpDown>

                <Slider x:Name="StopSlider" 
                        Grid.Column="1"
                        mah:SliderHelper.EnableMouseWheel="MouseHover"
                        AutoToolTipPlacement="{StaticResource SliderAutoToolTipPlacement}"
                        AutoToolTipPrecision="{StaticResource SliderTooltipPrecision}"
                        Minimum="1"
                        Maximum="5"
                        Value="3"
                        Margin="5, 0,0,0"
                        Style="{StaticResource HandlingSliderStyle}"
                        ValueChanged="StopSlider_OnValueChanged"
                        IsEnabled="{Binding IsEnabled, ElementName=StopBox, Mode=OneWay}"/>
                
                <mah:ToggleSwitch Grid.Column="2"
                                  x:Name="StopToggle"
                                  Margin="5 0 0 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  Content="超级刹车（LT自动）"
                                  IsEnabled="{Binding ViewModel.AreUiElementsEnabled, Mode=OneWay}"
                                  Toggled="StopSwitch_OnToggled"/>
                
            </Grid>
        </Border>

        <Border Style="{StaticResource CommonBorderStyle}">
            <Grid Margin="5 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="2 0 0 0"
                       Style="{StaticResource HandlingInlineLabelStyle}"
                       Content="日常(%):"/>

                <mah:NumericUpDown Grid.Row="0"
                                   Grid.Column="1"
                                   x:Name="BrakeAssistNormalStrengthBox"
                                   VerticalAlignment="Center"
                                   Width="90"
                                   Minimum="0"
                                   Maximum="100"
                                   Margin="6 0 0 0"
                                   ValueChanged="BrakeAssistNormalStrength_OnValueChanged"
                                   Style="{StaticResource HandlingCompactNumericUpDownStyle}">
                    <mah:NumericUpDown.IsEnabled>
                        <MultiBinding Converter="{StaticResource AndBooleanMultiConverter}">
                            <Binding Path="IsEnabled" ElementName="BrakeAssistToggle"/>
                            <Binding Path="IsOn" ElementName="BrakeAssistToggle"/>
                        </MultiBinding>
                    </mah:NumericUpDown.IsEnabled>
                </mah:NumericUpDown>

                <Label Grid.Row="0"
                       Grid.Column="2"
                       Margin="12 0 0 0"
                       Style="{StaticResource HandlingInlineLabelStyle}"
                       Content="急刹阈值(%):"/>

                <mah:NumericUpDown Grid.Row="0"
                                   Grid.Column="3"
                                   x:Name="BrakeAssistPanicThresholdBox"
                                   VerticalAlignment="Center"
                                   Width="90"
                                   Minimum="0"
                                   Maximum="100"
                                   Margin="6 0 0 0"
                                   ValueChanged="BrakeAssistPanicThreshold_OnValueChanged"
                                   Style="{StaticResource HandlingCompactNumericUpDownStyle}">
                    <mah:NumericUpDown.IsEnabled>
                        <MultiBinding Converter="{StaticResource AndBooleanMultiConverter}">
                            <Binding Path="IsEnabled" ElementName="BrakeAssistToggle"/>
                            <Binding Path="IsOn" ElementName="BrakeAssistToggle"/>
                        </MultiBinding>
                    </mah:NumericUpDown.IsEnabled>
                </mah:NumericUpDown>

                <Label Grid.Row="0"
                       Grid.Column="4"
                       Margin="12 0 0 0"
                       Style="{StaticResource HandlingInlineLabelStyle}"
                       Content="急刹(%):"/>

                <mah:NumericUpDown Grid.Row="0"
                                   Grid.Column="5"
                                   x:Name="BrakeAssistPanicStrengthBox"
                                   VerticalAlignment="Center"
                                   Width="90"
                                   Minimum="0"
                                   Maximum="100"
                                   Margin="6 0 0 0"
                                   ValueChanged="BrakeAssistPanicStrength_OnValueChanged"
                                   Style="{StaticResource HandlingCompactNumericUpDownStyle}">
                    <mah:NumericUpDown.IsEnabled>
                        <MultiBinding Converter="{StaticResource AndBooleanMultiConverter}">
                            <Binding Path="IsEnabled" ElementName="BrakeAssistToggle"/>
                            <Binding Path="IsOn" ElementName="BrakeAssistToggle"/>
                        </MultiBinding>
                    </mah:NumericUpDown.IsEnabled>
                </mah:NumericUpDown>

                <mah:ToggleSwitch Grid.Row="0"
                                  Grid.Column="6"
                                  x:Name="BrakeAssistToggle"
                                  Margin="10 0 0 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  Content="刹车增强（LT自动）"
                                  IsEnabled="{Binding ViewModel.AreUiElementsEnabled, Mode=OneWay}"
                                  Toggled="BrakeAssistSwitch_OnToggled"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="7"
                           Margin="2 6 0 0"
                           Style="{StaticResource HandlingDiagnosticTextBlockStyle}"
                           Text="{Binding ViewModel.BrakeAssistDiagnosticsText, Mode=OneWay}"/>
            </Grid>
        </Border>
        
        <Border Style="{StaticResource CommonBorderStyle}" Height="Auto">
            <Grid Margin="5 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- NoWaterDrag -->
                    <ColumnDefinition Width="Auto"/> <!-- NoClip -->
                    <ColumnDefinition Width="Auto"/> <!-- UnbreakableSkillScore -->
                    <ColumnDefinition Width="Auto"/> <!-- Label -->
                    <ColumnDefinition Width="Auto"/> <!-- NumericUpDown -->
                    <ColumnDefinition Width="Auto"/> <!-- Enable Toggle -->
                </Grid.ColumnDefinitions>
                
                <mah:ToggleSwitch Grid.Column="0"
                                  Margin="5 0 5 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  Content="{DynamicResource NoWaterDrag}"
                                  Toggled="NoWaterDragSwitch_OnToggled"/>
                
                <mah:ToggleSwitch Grid.Column="1"
                                  Margin="5 0 5 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  Content="{DynamicResource NoClip}"
                                  IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                  Toggled="NoClipSwitch_OnToggled"/>
                
                <mah:ToggleSwitch Grid.Column="2"
                                  x:Name="QuickUnbreakableSkillScoreSwitch"
                                  Margin="5 0 5 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                  Content="{DynamicResource UnbreakableSkillScore}"
                                  Toggled="QuickUnbreakableSkillScoreSwitch_OnToggled"/>
                
                <Label Grid.Column="3"
                       Margin="5 0 0 0"
                       Style="{StaticResource HandlingInlineLabelStyle}"
                       Content="技能分数倍率:"/>
                
                <mah:NumericUpDown Grid.Column="4"
                                   x:Name="QuickSkillScoreBox"
                                   VerticalAlignment="Center"
                                   Width="90"
                                   Minimum="1"
                                   Maximum="15"
                                   Value="1"
                                   Margin="5 0 5 0"
                                   ValueChanged="QuickSkillScoreBox_ValueChanged"
                                   Style="{StaticResource HandlingCompactNumericUpDownStyle}">
                    <mah:NumericUpDown.IsEnabled>
                        <MultiBinding Converter="{StaticResource AndBooleanMultiConverter}">
                            <Binding Path="IsEnabled" ElementName="QuickSkillScoreToggle"/>
                            <Binding Path="IsOn" ElementName="QuickSkillScoreToggle"/>
                        </MultiBinding>
                    </mah:NumericUpDown.IsEnabled>
                </mah:NumericUpDown>
                
                <mah:ToggleSwitch Grid.Column="5"
                                  x:Name="QuickSkillScoreToggle"
                                  Margin="5 0 5 0"
                                  Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                  IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                  Content="启用"
                                  Toggled="QuickSkillScoreToggle_Toggled"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource CommonBorderStyle}" Height="Auto">
            <StackPanel Margin="5 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="QuickNameBox"
                             Grid.Column="0"
                             MaxLength="16"
                             VerticalAlignment="Center"
                             TextAlignment="Left"
                             Style="{StaticResource HandlingCompactTextBoxStyle}"
                             IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                             TextChanged="QuickNameBox_OnTextChanged"/>

                    <mah:ToggleSwitch x:Name="QuickNameSpooferSwitch"
                                      Grid.Column="1"
                                      Margin="5 0 5 0"
                                      Style="{StaticResource HandlingToggleSwitchCompactStyle}"
                                      IsEnabled="{Binding ViewModel.AreUiElementsEnabled}"
                                      Content="{DynamicResource NameSpoofer}"
                                      Toggled="QuickNameSpooferSwitch_OnToggled"/>
                </Grid>
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
