<Page x:Class="HorizonTuner.Views.ExpandersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HorizonTuner.Views"
      mc:Ignorable="d"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:subPages="clr-namespace:HorizonTuner.Views.SubPages.SelfVehicle"
      xmlns:tnPages="clr-namespace:HorizonTuner.Views.SubPages.Tuning"
      xmlns:converters="clr-namespace:HorizonTuner.Converters"
      Title="ExpandersView" 
      d:DataContext="{d:DesignInstance local:ExpandersView,IsDesignTimeCreatable=True}"
      d:DesignHeight="450" 
      d:DesignWidth="800"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="Auto"
      UseLayoutRounding="True">
    <Page.Resources>
        <converters:TypeToInstanceConverter x:Key="LocalConverter"/>

        <!-- Expander 样式 - 苹果天气卡片风格 -->
        <Style TargetType="{x:Type Expander}">
            <Setter Property="Effect" Value="{DynamicResource CardGlowEffect}"/>
            <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="{DynamicResource FontSizeGiant}"/>
            <Setter Property="mah:HeaderedControlHelper.HeaderFontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleGradientBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundGradient}"/>
            <Setter Property="mah:HeaderedControlHelper.HeaderBackground" Value="{DynamicResource CardBackgroundGradient}"/>
            <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource CardCornerRadiusLarge}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="18 0 18 18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Effect" Value="{DynamicResource CardGlowEffectHover}"/>
                </Trigger>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter Property="Effect" Value="{DynamicResource CardGlowEffectActive}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem 样式 -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleGradientBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Effect" Value="{DynamicResource CardGlowEffectActive}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Effect" Value="{DynamicResource CardGlowEffectHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <TabControl Margin="10 10 10 10" SelectedIndex="0">
        
        <!-- Tab 1: 资源与基础功能类 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource ModuleResourcesIcon}" FontSize="18" Margin="0 0 6 0" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{DynamicResource ModuleResourcesTitle}" TextOptions.TextFormattingMode="Display"/>
                </StackPanel>
            </TabItem.Header>
            
            <ScrollViewer>
                <StackPanel>
                    <Expander x:Name="AutoshowExpander"
                              Header="车展"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Autoshow}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="GarageExpander"
                              Header="车库"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Garage}, Mode=OneWay}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Tab 2: 核心体验修改类 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource ModuleCoreIcon}" FontSize="18" Margin="0 0 6 0" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{DynamicResource ModuleCoreTitle}" TextOptions.TextFormattingMode="Display"/>
                </StackPanel>
            </TabItem.Header>
            
            <ScrollViewer>
                <StackPanel>
                    <Expander x:Name="HandlingExpander"
                              Header="速度修改"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Handling}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="UnlocksExpander"
                              Header="{DynamicResource Unlocks}"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Unlocks}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="WheelspinsExpander"
                              Header="抽奖"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Wheelspins}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="TimerFreezesExpander"
                              Header="计时器冻结"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:TimerFreezes}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="MultiExpander"
                              Header="倍率"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Multipliers}, Mode=OneWay}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Tab 3: 玩法与视觉扩展类 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource ModuleVisualIcon}" FontSize="18" Margin="0 0 6 0" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{DynamicResource ModuleVisualTitle}" TextOptions.TextFormattingMode="Display"/>
                </StackPanel>
            </TabItem.Header>
            
            <ScrollViewer>
                <StackPanel>
                    <Expander x:Name="PhotoModeExpander"
                              Header="{DynamicResource PhotoMode}"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:PhotoMode}, Mode=OneWay}" />
                    </Expander>
                    
                    <Expander x:Name="EnvironmentExpander"
                              Header="世界"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Environment}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="CustomizationExpander"
                              Header="{DynamicResource Customization}"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Customization}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="MiscExpander"
                              Header="实验性/不稳定"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Misc}, Mode=OneWay}" />
                    </Expander>

                    <Expander x:Name="CameraExpander"
                              Header="{DynamicResource Camera}"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type subPages:Camera}, Mode=OneWay}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Tab 4: 专业性能调校类 -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource ModuleTuningIcon}" FontSize="18" Margin="0 0 6 0" TextOptions.TextFormattingMode="Display"/>
                    <TextBlock Text="{DynamicResource ModuleTuningTitle}" TextOptions.TextFormattingMode="Display"/>
                </StackPanel>
            </TabItem.Header>
            
            <ScrollViewer>
                <StackPanel>
                    <Expander Header="调校（轮胎）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Tires}, Mode=OneWay}"/>
                    </Expander>

                    <Expander Header="调校（齿比）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Gearing}, Mode=OneWay}"/>
                    </Expander>
                    
                    <Expander Header="调校（定位）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Alignment}, Mode=OneWay}"/>
                    </Expander>

                    <Expander Header="调校（弹簧）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Springs}, Mode=OneWay}"/>
                    </Expander>

                    <Expander Header="调校（阻尼）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Damping}, Mode=OneWay}"/>
                    </Expander>

                    <Expander Header="调校（空气动力）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Aero}, Mode=OneWay}"/>
                    </Expander>

                    <Expander Header="调校（转向）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Steering}, Mode=OneWay}"/>
                    </Expander>
                    
                    <Expander Header="调校（杂项）"
                              IsEnabled="{Binding ViewModel.Attached}">
                        <Frame Content="{Binding Converter={StaticResource LocalConverter}, 
                               ConverterParameter={x:Type tnPages:Others}, Mode=OneWay}"/>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

    </TabControl>
</Page>