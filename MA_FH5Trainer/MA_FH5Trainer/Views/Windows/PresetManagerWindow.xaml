<mah:MetroWindow x:Class="MA_FH5Trainer.Views.Windows.PresetManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:MA_FH5Trainer.ViewModels.Windows"
                 Title="预设管理"
                 Width="900"
                 Height="560"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource MahApps.Brushes.Window.Background}"
                 Foreground="{DynamicResource MahApps.Brushes.Window.Foreground}">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MA_FH5Trainer;component/Views/SubPages/SelfVehicle/HandlingResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ApplyAndCloseCommand}"/>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding ApplyCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveEditsCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding RevertEditsCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
    </mah:MetroWindow.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="DetailsRow" Height="0">
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactLayoutConverter}}"
                                         Value="True">
                                <Setter Property="Height" Value="*"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DetailsColumn" Width="320">
                <ColumnDefinition.Style>
                    <Style TargetType="{x:Type ColumnDefinition}">
                        <Setter Property="Width" Value="320"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactLayoutConverter}}"
                                         Value="True">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="多段式加速预设管理"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 14"
                   Style="{StaticResource HandlingTextBlockStyle}"/>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Style="{StaticResource HandlingTextBoxStyle}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     ToolTip="搜索预设名称（Ctrl+F）"/>

            <ComboBox Grid.Column="2"
                      Style="{StaticResource HandlingCompactComboBoxStyle}"
                      ItemsSource="{Binding SortOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Mode"
                      SelectedValue="{Binding SelectedSortMode}"
                      VerticalContentAlignment="Center"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="列表"
                        Style="{StaticResource HandlingSubtleActionButtonCompactStyle}"
                        Margin="0 0 8 0"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static vm:PresetViewMode.List}"/>
                <Button Content="卡片"
                        Style="{StaticResource HandlingSubtleActionButtonCompactStyle}"
                        Command="{Binding SetViewModeCommand}"
                        CommandParameter="{x:Static vm:PresetViewMode.Card}"/>
            </StackPanel>

            <TextBlock Grid.Column="6"
                       Style="{StaticResource HandlingTextBlockStyle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Text="{Binding SummaryText}"/>
        </Grid>

        <Grid x:Name="PresetsRegion"
              Grid.Row="2" Grid.Column="0" Margin="0 0 12 0">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Grid.Row" Value="2"/>
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                    <Setter Property="Margin" Value="0 0 12 0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactLayoutConverter}}"
                                     Value="True">
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ListView x:Name="PresetsListView"
                      ItemsSource="{Binding PresetsView}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource HandlingListViewItemStyle}"
                      MouseDoubleClick="PresetsListView_OnMouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="应用"
                                  Command="{Binding PlacementTarget.DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="应用并关闭"
                                  Command="{Binding PlacementTarget.DataContext.ApplyAndCloseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="重命名"
                                  Command="{Binding PlacementTarget.DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.Style>
                    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource HandlingListViewStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:PresetViewMode.List}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="预设名称" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="热度" Width="80" DisplayMemberBinding="{Binding HotScore, StringFormat={}{0:0}}"/>
                        <GridViewColumn Header="使用次数" Width="80" DisplayMemberBinding="{Binding UseCount}"/>
                        <GridViewColumn Header="最近使用" Width="160" DisplayMemberBinding="{Binding LastUsedTimeText}"/>
                        <GridViewColumn Header="创建时间" Width="160" DisplayMemberBinding="{Binding CreatedTimeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <ListBox x:Name="PresetsCardListBox"
                     ItemsSource="{Binding PresetsView}"
                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource HandlingCardListBoxItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PresetsCardListBox_OnMouseDoubleClick">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="应用"
                                  Command="{Binding PlacementTarget.DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="应用并关闭"
                                  Command="{Binding PlacementTarget.DataContext.ApplyAndCloseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="重命名"
                                  Command="{Binding PlacementTarget.DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="删除"
                                  Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Style>
                    <Style TargetType="{x:Type ListBox}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:PresetViewMode.Card}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="240">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}"/>
                            <TextBlock Grid.Row="1"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding HotScore, StringFormat=热度 {0:0}}"/>
                            <TextBlock Grid.Row="2"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding UseCount, StringFormat=使用 {0} 次}"/>
                            <TextBlock Grid.Row="3"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding LastUsedTimeText, StringFormat=最近 {0}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border x:Name="DetailsBorder"
                Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{DynamicResource ControlBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="14">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Grid.Row" Value="2"/>
                    <Setter Property="Grid.Column" Value="1"/>
                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactLayoutConverter}}"
                                     Value="True">
                            <Setter Property="Grid.Row" Value="3"/>
                            <Setter Property="Grid.Column" Value="0"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="Margin" Value="0 12 0 0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource HandlingTextBlockStyle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="未选择预设"/>
                            <TextBlock Style="{StaticResource HandlingTextBlockStyle}"
                                       Margin="0 8 0 0"
                                       Text="在左侧选择一个预设以查看参数与统计。"/>
                        </StackPanel>

                        <Grid>
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Style="{StaticResource HandlingTextBlockStyle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedPreset.Name}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="重命名"
                                            Margin="0 0 8 0"
                                            Style="{StaticResource HandlingSubtleActionButtonCompactStyle}"
                                            Command="{Binding RenameCommand}"/>
                                    <Button Content="删除"
                                            Style="{StaticResource HandlingSubtleActionButtonCompactStyle}"
                                            Command="{Binding DeleteCommand}"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Grid.Row="1"
                                       Margin="0 10 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding SelectedPreset.HotScore, StringFormat=热度 {0:0}}"/>
                            <TextBlock Grid.Row="2"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding SelectedPreset.UseCount, StringFormat=使用次数 {0}}"/>
                            <TextBlock Grid.Row="3"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding SelectedPreset.LastUsedTimeText, StringFormat=最近使用 {0}}"/>
                            <TextBlock Grid.Row="4"
                                       Margin="0 6 0 0"
                                       Style="{StaticResource HandlingTextBlockStyle}"
                                       Text="{Binding SelectedPreset.CreatedTimeText, StringFormat=创建时间 {0}}"/>

                            <Border Grid.Row="5"
                                    Margin="0 14 0 0"
                                    Background="{DynamicResource HandlingInputSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="{DynamicResource ControlBorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="12">
                                <Grid Grid.IsSharedSizeScope="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PresetEditLabel"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Row="0" Grid.ColumnSpan="5" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Style="{StaticResource HandlingTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   Text="参数编辑"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Text="未保存修改"
                                                       Margin="0 0 8 0">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HandlingTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                       Text="{Binding SaveFeedbackText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HandlingTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SaveFeedbackText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SaveFeedbackText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HandlingTextBlockStyle}"
                                               Text="Gamma"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource HandlingTextBlockStyle}"
                                               Text="比例"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource HandlingTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Text="起步段"/>
                                    <mah:NumericUpDown Grid.Row="2" Grid.Column="2"
                                                       Interval="0.1"
                                                       Minimum="0.1"
                                                       Maximum="10"
                                                       Value="{Binding EditStage1Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage1GammaDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>
                                    <mah:NumericUpDown Grid.Row="2" Grid.Column="4"
                                                       Interval="5"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       StringFormat="{}{0:N0}%"
                                                       Value="{Binding EditStage1ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage1ScaleDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource HandlingTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Text="中速段"/>
                                    <mah:NumericUpDown Grid.Row="3" Grid.Column="2"
                                                       Interval="0.1"
                                                       Minimum="0.1"
                                                       Maximum="10"
                                                       Value="{Binding EditStage2Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage2GammaDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>
                                    <mah:NumericUpDown Grid.Row="3" Grid.Column="4"
                                                       Interval="5"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       StringFormat="{}{0:N0}%"
                                                       Value="{Binding EditStage2ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage2ScaleDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>

                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                               Style="{StaticResource HandlingTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Text="高速段"/>
                                    <mah:NumericUpDown Grid.Row="4" Grid.Column="2"
                                                       Interval="0.1"
                                                       Minimum="0.1"
                                                       Maximum="10"
                                                       Value="{Binding EditStage3Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage3GammaDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>
                                    <mah:NumericUpDown Grid.Row="4" Grid.Column="4"
                                                       Interval="5"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       StringFormat="{}{0:N0}%"
                                                       Value="{Binding EditStage3ScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <mah:NumericUpDown.Style>
                                            <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource HandlingCompactNumericUpDownStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStage3ScaleDirty}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </mah:NumericUpDown.Style>
                                    </mah:NumericUpDown>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="0 12 0 0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0 1 0 0"
                        Padding="0 12 0 0"
                        Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.IsEnabled>
                                <Binding Path="HasSelectedPreset"/>
                            </StackPanel.IsEnabled>
                            <Button Content="保存"
                                    Margin="0 0 8 0"
                                    Style="{StaticResource HandlingAccentButtonStyle}"
                                    Command="{Binding SaveEditsCommand}"/>
                            <Button Content="撤销"
                                    Margin="0 0 8 0"
                                    Style="{StaticResource HandlingButtonStyle}"
                                    Command="{Binding RevertEditsCommand}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.IsEnabled>
                                <Binding Path="HasSelectedPreset"/>
                            </StackPanel.IsEnabled>
                            <Button Content="应用"
                                    Margin="0 0 8 0"
                                    Style="{StaticResource HandlingButtonStyle}"
                                    Command="{Binding ApplyCommand}"/>
                            <Button Content="应用并关闭"
                                    Style="{StaticResource HandlingAccentButtonStyle}"
                                    Command="{Binding ApplyAndCloseCommand}"/>
                        </StackPanel>

                        <Button Grid.Row="1" Grid.Column="0"
                                Content="另存为"
                                Margin="0 10 0 0"
                                Style="{StaticResource HandlingSubtleActionButtonStyle}"
                                Command="{Binding SaveAsNewCommand}"/>

                        <Button Grid.Row="1" Grid.Column="2"
                                Content="关闭"
                                Margin="0 10 0 0"
                                Style="{StaticResource HandlingButtonStyle}"
                                Click="CloseButton_OnClick"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
